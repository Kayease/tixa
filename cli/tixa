#!/usr/bin/env bash
set -e

BASE_DIR="/opt/tixa"
CMD="$1"

case "$CMD" in
  create)
    bash "$BASE_DIR/core/create.sh"
    ;;
  doctor)
    shift
    bash "$BASE_DIR/core/doctor.sh" "$@"
    ;;
  list)
    bash "$BASE_DIR/core/list.sh"
    ;;
  delete)
    bash "$BASE_DIR/core/delete.sh" "$2"
    ;;
  migrate)
    shift
    bash "$BASE_DIR/core/migrate.sh" "$@"
    ;;
  verify)
    shift
    bash "$BASE_DIR/cli/verify.sh" "$@"
    ;;
  ssl)
    shift
    bash "$BASE_DIR/cli/ssl.sh" "$@"
    ;;
  sslemail)
    shift
    bash "$BASE_DIR/core/sslemail.sh" "$@"
    ;;
  update)
    shift
    bash "$BASE_DIR/core/update.sh" "$@"
    ;;
  self-update)
    shift
    bash "$BASE_DIR/core/self-update.sh" "$@"
    ;;
  uninstall)
    shift
    bash "$BASE_DIR/core/uninstall.sh" "$@"
    ;;
  *)
    echo "TIXA · Media Service CLI"
    echo ""
    echo "Usage:"
    echo "  tixa create                 Create a new media service"
    echo "  tixa doctor                 Check VPS compatibility and dependencies"
    echo "  tixa list                   List all services"
    echo "  tixa verify <name>          Verify service"
    echo "  tixa delete <name>          Delete service"
    echo "  tixa migrate <name>         Rename a service and migrate its domain"
    echo ""
    echo "SSL:"
    echo "  tixa sslemail set"
    echo "  tixa sslemail show"
    echo "  tixa ssl renew <name>"
    echo "  tixa ssl renew --all"
    echo ""
    echo "Updates:"
    echo "  tixa self-update            Update the Tixa CLI and templates"
    echo "  tixa update <name>          Update specific service"
    echo "  tixa update --all           Update all services"
    echo "  tixa update --all --yes     Update all (skip confirmation)"
    echo ""
    echo "Maintenance:"
    echo "  tixa uninstall"
    echo "  tixa uninstall --hard"
    ;;
esac
